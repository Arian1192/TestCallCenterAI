# ───────────── Servidor ─────────────
PORT=3000
# Clave que ElevenLabs enviará al llamar a tus herramientas (y para entrar al panel).
# Pon una cadena larga y aleatoria. Genérala con:  node -e "console.log(require('crypto').randomUUID())"
TOOLS_API_KEY=cambia-esto-por-una-clave-larga

# ───────────── Datos de pisos ─────────────
# mock = cartera de ejemplo (src/services/propiedades/mock.ts) · inmovilla = API real
DATA_PROVIDER=mock
INMOVILLA_API_TOKEN=
# true = al reservar visita o registrar interés, crea el cliente en Inmovilla
INMOVILLA_CREAR_CLIENTES=false
CACHE_REFRESH_MINUTES=10

# ───────────── Agenda de visitas ─────────────
TIMEZONE=Europe/Madrid
VISITA_DURACION_MIN=45
HORARIO_LABORABLE=10:00-14:00,16:30-20:00
HORARIO_SABADO=10:00-13:30
DIAS_ANTELACION=7

# ───────────── ElevenLabs (para npm run setup:agent) ─────────────
ELEVENLABS_API_KEY=
# URL pública HTTPS de este servidor (la que te da Cloudflare Tunnel), sin barra final
PUBLIC_URL=https://xxxx.trycloudflare.com
AGENCIA_NOMBRE=Inmobiliaria Demo
# Opcional: ID de una voz con acento de España de la Voice Library
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=gemini-2.5-flash
# eleven_flash_v2_5 (más rápido) o eleven_v3_conversational (más expresivo)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Opcional: secreto del webhook post-llamada (Settings → Webhooks en ElevenLabs)
ELEVENLABS_WEBHOOK_SECRET=
